# Pango API (pango-core). No trailing slash, no path prefix.
VITE_API_BASE_URL=http://localhost:3000

# Domain organizations are served from: <subdomain>.<VITE_APP_BASE_DOMAIN>
# (must match APP_BASE_DOMAIN in pango-core). Production: onpango.com
VITE_APP_BASE_DOMAIN=localhost

# Optional: pin the organization instead of reading it from the hostname.
# Handy when you open http://localhost:5173 directly. Required with the mock backend.
VITE_DEV_TENANT=pango

# Use the in-browser mock backend instead of pango-core.
VITE_USE_MOCK=true
